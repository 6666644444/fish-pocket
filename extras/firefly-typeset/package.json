{
  "name": "firefly-typeset",
  "version": "1.0.0",
  "private": true,
  "description": "Lays replies out to read well on a phone: display formulas, boxed answers, headed steps and coloured callouts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "keywords": ["dsh-plugin", "firefly"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
